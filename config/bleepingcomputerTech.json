{
    "scrprType": "puppeteer",
    "dataType": "news",
    "scrprOptions": {
        "url": "https://www.bleepingcomputer.com/",
        "currentPage": 1,
        "maxPages": 1,
        "selectorToWaitFor": ".bc_latest_news #bc-home-news-main-wrap",
        "elementsRoot": ".bc_latest_news #bc-home-news-main-wrap > li",
        "rawFields": {
            "title": { "selector": ".bc_latest_news_text h4 a" },
            "imageURL": {
                "selector": ".nonexistent_selector",
                "attribute": "src"
            },
            "publishedAt": {
                "selector": ".bc_latest_news_text ul .bc_news_date"
            },
            "articleLink": {
                "selector": ".bc_latest_news_text h4 a",
                "attribute": "href"
            },
            "summary": { "selector": ".bc_latest_news_text p" }
        }
    }
}
